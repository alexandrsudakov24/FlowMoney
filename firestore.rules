rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper — checks the `admin` custom claim set via Admin SDK
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Verify family membership via the user's profile document (familyId field)
    function isFamilyMember(familyId) {
      return request.auth != null &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId;
    }

    // True if the caller owns the given family (checked against the family doc itself)
    function isFamilyOwner(familyId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/families/$(familyId)) &&
             get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid;
    }

    // Lets a family owner clear (only) a former member's own familyId pointer, and nothing
    // else on that member's profile — this is what actually revokes their access, since
    // isFamilyMember() is keyed off each user's own pointer rather than the family's member
    // list. The pointer may only be removed, never reassigned to a different family.
    function isOwnerRemovingMember(userId) {
      return request.auth != null &&
             request.auth.uid != userId &&
             resource.data.get('familyId', null) != null &&
             isFamilyOwner(resource.data.get('familyId', null)) &&
             !('familyId' in request.resource.data) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId']);
    }

    // Allow a family update where only the members array changes (not ownerId/name).
    // Used when a new member accepts an invitation — at that moment their users/{uid}.familyId
    // hasn't been saved yet, so isFamilyMember() would return false.
    // NOTE: this still requires a verified email; a proper fix would use Cloud Functions.
    function isSafeJoin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.resource.data.ownerId == resource.data.ownerId &&
             request.resource.data.name == resource.data.name;
    }

    // Personal user data — only the owner can read/write their own document;
    // admin can get any individual document or list the whole collection.
    match /users/{userId} {
      allow get: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId) ||
                       isOwnerRemovingMember(userId) ||
                       isAdmin();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, delete: if isAdmin();
      }
    }

    // Family documents — only actual members may read; joining via invitation is allowed
    // via isSafeJoin(); only the owner may delete.
    match /families/{familyId} {
      allow create: if request.auth != null && request.auth.token.email != null;
      allow read:   if isFamilyMember(familyId) || isAdmin();
      allow update: if (isFamilyMember(familyId) || isSafeJoin()) &&
                       request.auth != null && request.auth.token.email != null;
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.ownerId;

      // Shared expenses — only family members (not any authenticated user)
      match /expenses/{expenseId} {
        allow read, write: if isFamilyMember(familyId) || isAdmin();
      }

      // Family-level settings — only family members
      match /settings/{doc} {
        allow read, write: if isFamilyMember(familyId) || isAdmin();
      }
    }

    // Invitations — only the family owner may create; only the invited user can read/update their own invitations
    match /invitations/{invitationId} {
      allow create: if request.auth != null &&
                       request.auth.token.email != null &&
                       isFamilyOwner(request.resource.data.familyId);
      allow read:   if request.auth != null && request.auth.token.email != null && (
                      resource.data.invitedEmail == request.auth.token.email ||
                      isFamilyMember(resource.data.familyId) ||
                      isAdmin()
                    );
      allow update: if request.auth != null &&
                       request.auth.token.email != null &&
                       resource.data.invitedEmail == request.auth.token.email;
    }
  }
}
